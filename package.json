{
  "name": "dsh-aux-degrade",
  "version": "1.0.0",
  "description": "DSH plugin: stop auxiliary LLM calls from burning the output budget. Degrades reasoning effort for compaction summaries, session titles and prompt enhancement; raises their max_tokens floor; appends verbatim-retention sections to compaction instructions; and strips tools from compaction calls, so a high default thinking level cannot silently truncate a checkpoint.",
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": {
    "name": "夏目",
    "url": "https://github.com/xiamubumu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiamubumu/dsh-aux-degrade.git"
  },
  "bugs": {
    "url": "https://github.com/xiamubumu/dsh-aux-degrade/issues"
  },
  "homepage": "https://github.com/xiamubumu/dsh-aux-degrade#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "reasoning-effort",
    "thinking",
    "auxiliary",
    "llm",
    "compaction"
  ],
  "engines": {
    "dsh": ">=0.1.5-rc.2 <0.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
